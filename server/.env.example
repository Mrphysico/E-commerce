# TechNova Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# If MongoDB is running locally, use mongodb://127.0.0.1:27017/technova
# If you don't have MongoDB installed, set USE_MEMORY_DB=true to auto-spawn an in-memory MongoDB!
MONGODB_URI=mongodb://127.0.0.1:27017/technova
USE_MEMORY_DB=false

# Authentication
JWT_SECRET=technova_super_secure_jwt_secret_key_2026_electronics
JWT_EXPIRE=7d

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Optional Payment Gateway (Razorpay test mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
